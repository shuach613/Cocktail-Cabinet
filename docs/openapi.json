{
  "openapi": "3.0.3",
  "info": {
    "title": "Cocktail Cabinet API",
    "version": "1.0.0",
    "description": "Private self-hosted cocktail collection. Each request requires a personal bearer token. Write operations also check recipe ownership and administrator role. All images use authenticated downloads; never embed tokens in URLs."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "personalBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Opaque personal API token"
      }
    },
    "schemas": {
      "Ingredient": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ingredient",
              "garnish",
              "ice"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "is_brand": {
            "type": "boolean"
          },
          "category_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "Recipe": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "technique": {
            "type": "string"
          },
          "glass": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ingredients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            }
          },
          "image_url": {
            "type": "string",
            "nullable": true
          },
          "created_by": {
            "type": "integer",
            "nullable": true
          },
          "can_edit": {
            "type": "boolean"
          }
        }
      },
      "RecipeInput": {
        "type": "object",
        "required": [
          "title",
          "steps",
          "items"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "technique": {
            "type": "string",
            "enum": [
              "Built",
              "Stirred",
              "Shaken",
              "Blended",
              "Layered",
              "Other"
            ]
          },
          "glass": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            }
          },
          "new_categories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "temp_id": {
                  "type": "string",
                  "example": "new:1"
                },
                "name": {
                  "type": "string"
                },
                "parent_id": {
                  "oneOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "status": {
                "type": "integer"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "ShelfChange": {
        "type": "object",
        "required": [
          "owned"
        ],
        "additionalProperties": false,
        "properties": {
          "ingredient_id": {
            "type": "integer",
            "minimum": 1
          },
          "category_id": {
            "type": "integer",
            "minimum": 1
          },
          "owned": {
            "type": "boolean"
          }
        },
        "oneOf": [
          {
            "required": [
              "ingredient_id"
            ]
          },
          {
            "required": [
              "category_id"
            ]
          }
        ]
      },
      "Shelf": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "integer"
          },
          "revision": {
            "type": "integer"
          },
          "owned_category_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "owned_ingredient_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/me": {
      "get": {
        "summary": "Get authenticated user and token scope",
        "operationId": "getMe",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "User identity"
          },
          "401": {
            "description": "Invalid token"
          }
        }
      }
    },
    "/recipes": {
      "get": {
        "summary": "Read all recipes, with pagination and optional filters",
        "operationId": "listRecipes",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Recipe list and pagination"
          },
          "401": {
            "description": "Invalid token"
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "technique",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "summary": "Create recipe, optionally also adding ingredients and nested categories",
        "operationId": "createRecipe",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Recipe created"
          },
          "400": {
            "description": "Invalid recipe"
          },
          "403": {
            "description": "Read-only token"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeInput"
              }
            }
          }
        }
      }
    },
    "/recipes/{recipe_id}": {
      "get": {
        "summary": "Read recipe, ingredients, classification and preparation steps",
        "operationId": "getRecipe",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Recipe"
          },
          "404": {
            "description": "Not found"
          }
        },
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "patch": {
        "summary": "Partially update an owned recipe (admin can update any)",
        "operationId": "patchRecipe",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Recipe updated"
          },
          "403": {
            "description": "Not permitted"
          },
          "404": {
            "description": "Not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "put": {
        "summary": "Replace recipe content",
        "operationId": "replaceRecipe",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Recipe updated"
          },
          "403": {
            "description": "Not permitted"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeInput"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "delete": {
        "summary": "Delete an owned recipe",
        "operationId": "deleteRecipe",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "403": {
            "description": "Not permitted"
          }
        },
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/recipes/{recipe_id}/image": {
      "get": {
        "summary": "Download recipe image with bearer token; add ?download=1 for attachment",
        "operationId": "downloadRecipeImage",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Binary WebP image"
          },
          "404": {
            "description": "No image"
          }
        },
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "post": {
        "summary": "Upload and replace recipe image (JPEG, PNG or WebP, up to 4 MB)",
        "operationId": "uploadRecipeImage",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Image uploaded"
          },
          "400": {
            "description": "Invalid image"
          },
          "403": {
            "description": "Not permitted"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "image"
                ],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      },
      "delete": {
        "summary": "Remove recipe image (owner or admin)",
        "operationId": "deleteRecipeImage",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "403": {
            "description": "Not permitted"
          }
        },
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/ingredients": {
      "get": {
        "summary": "List ingredients and generic classifications",
        "operationId": "listIngredients",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Ingredients"
          }
        }
      },
      "post": {
        "summary": "Add and classify ingredient; optionally create nested categories in the same transaction",
        "operationId": "createIngredient",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Invalid ingredient"
          },
          "403": {
            "description": "Read-only token"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "categories"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "is_brand": {
                    "type": "boolean"
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    }
                  },
                  "new_categories": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ingredients/{ingredient_id}": {
      "patch": {
        "summary": "Admin-only rename or reclassify ingredient",
        "operationId": "updateIngredient",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Updated"
          },
          "403": {
            "description": "Not an administrator"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "categories": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "get": {
        "summary": "Read ingredient taxonomy",
        "operationId": "listCategories",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Categories"
          }
        }
      },
      "post": {
        "summary": "Admin-only create category",
        "operationId": "createCategory",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Not an administrator"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "parent_id": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/categories/{category_id}": {
      "patch": {
        "summary": "Admin-only rename or move category",
        "operationId": "updateCategory",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Updated"
          },
          "403": {
            "description": "Not an administrator"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "parent_id": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "/changes": {
      "get": {
        "summary": "Current shared collection revision and this user's private shelf revision",
        "operationId": "getChanges",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Revision counter"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "Machine-readable OpenAPI specification",
        "operationId": "openApi",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "OpenAPI schema"
          }
        }
      }
    },
    "/shelf": {
      "get": {
        "operationId": "getMyShelf",
        "summary": "List the connected user's shelf and owned state",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated personal shelf response"
          },
          "400": {
            "description": "Invalid shelf operation"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Read-only token"
          }
        }
      }
    },
    "/shelf/items": {
      "post": {
        "operationId": "setShelfItemOwned",
        "summary": "Mark one branded bottle or generic subcategory owned/unowned, without replacing other selections",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated personal shelf response"
          },
          "400": {
            "description": "Invalid shelf operation"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Read-only token"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShelfChange"
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateMyShelf",
        "summary": "Atomically change up to 100 shelf selections; preserve all unspecified selections",
        "security": [
          {
            "personalBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated personal shelf response"
          },
          "400": {
            "description": "Invalid shelf operation"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Read-only token"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "changes"
                ],
                "additionalProperties": false,
                "properties": {
                  "changes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "$ref": "#/components/schemas/ShelfChange"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
