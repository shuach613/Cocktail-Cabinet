# Generate distinct long random values with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_AN_INDEPENDENT_64_CHARACTER_RANDOM_SECRET
SETUP_TOKEN=CHANGE_ME_TO_ANOTHER_INDEPENDENT_RANDOM_SETUP_KEY
HOST_PORT=1931
# Use true behind an HTTPS reverse proxy. Set false ONLY for HTTP testing on a trusted LAN.
COOKIE_SECURE=true
# True when behind one trusted reverse proxy such as Synology DSM's HTTPS proxy.
TRUST_PROXY=true
# Optional SMTP to actually email invitations; otherwise admin can copy the one-time link.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
